{{!-- COF2 Options : onglet Compétences (Atlas d'Osgild, système de compétence) --}}
<section class="tab cof2-options-skills{{#if tabs.skills.active}} active{{/if}}" data-group="primary" data-tab="skills">
  <div class="section-container">
    <div class="section-header">
      <h4>{{localize "COF2OPTIONS.sheet.tabs.skills"}}</h4>
      {{#if unlocked}}
        {{#with (cof2OptionsEconomy actor) as |economy|}}
          <div class="cof2-skills-economy" data-tooltip="{{localize 'COF2OPTIONS.sheet.pointsTooltip'}}">
            <i class="fas fa-fw fa-star"></i>
            {{economy.available}} / {{economy.pool}}
          </div>
        {{/with}}
      {{/if}}
    </div>
    <div class="section-body-no-flex">
      <ol class="cof2-skills-list item-list">
        {{#each (cof2OptionsSkills actor) as |skill|}}
          <li class="cof2-skill{{#if skill.mastered}} mastered{{/if}}" data-skill-id="{{skill.id}}">
            <a class="cof2-skill-name" data-action="cof2OptionsRollSkill" data-skill-id="{{skill.id}}" data-ability="{{lookup skill.abilities 0}}">
              {{localize (concat "COF2OPTIONS.skills." skill.id)}}
            </a>
            <span class="cof2-skill-abilities">
              {{#each skill.abilities as |ability|}}{{#unless @first}} / {{/unless}}<a data-action="cof2OptionsRollSkill" data-skill-id="{{skill.id}}" data-ability="{{ability}}" data-tooltip="{{localize (concat "CO.abilities.long." ability)}}">{{localize (concat "CO.abilities.short." ability)}}</a>{{/each}}
            </span>
            {{#if skill.mastered}}
              <i class="fas fa-shield-alt cof2-skill-mastered" data-tooltip="{{localize 'COF2OPTIONS.sheet.mastered'}}"></i>
            {{/if}}
            <div class="cof2-skill-controls">
              {{#if @root.unlocked}}
                <a class="cof2-skill-decrease{{#unless skill.canDecrease}} disabled{{/unless}}" data-action="cof2OptionsDecreaseSkill" data-skill-id="{{skill.id}}">
                  <i class="fas fa-minus"></i>
                </a>
              {{/if}}
              <span class="cof2-skill-bonus">{{numberFormat skill.bonus decimals=0 sign=true}}</span>
              {{#if @root.unlocked}}
                <a class="cof2-skill-increase{{#unless skill.canIncrease}} disabled{{/unless}}" data-action="cof2OptionsIncreaseSkill" data-skill-id="{{skill.id}}">
                  <i class="fas fa-plus"></i>
                </a>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ol>
    </div>
  </div>
  {{#if unlocked}}
    {{#with (cof2OptionsTrades actor) as |trades|}}
      {{#if trades.length}}
        <div class="section-container">
          <div class="section-header">
            <h4>{{localize "COF2OPTIONS.sheet.trades.title"}}</h4>
          </div>
          <div class="section-body-no-flex">
            <p class="cof2-trades-hint">{{localize "COF2OPTIONS.sheet.trades.hint"}}</p>
            <ol class="cof2-trades-list item-list">
              {{#each trades as |trade|}}
                <li class="cof2-trade{{#if trade.traded}} traded{{/if}}">
                  <label>
                    <input type="checkbox" data-action="cof2OptionsToggleTrade" data-capacity-id="{{trade.id}}" {{checked trade.traded}} {{#unless trade.canToggle}}class="disabled"{{/unless}} />
                    <span class="cof2-trade-name">{{trade.name}}</span>
                    <span class="cof2-trade-path">{{trade.pathName}}</span>
                    <span class="cof2-trade-points">{{localize "COF2OPTIONS.sheet.trades.points" points=trade.points}}</span>
                  </label>
                </li>
              {{/each}}
            </ol>
          </div>
        </div>
      {{/if}}
    {{/with}}
  {{/if}}
</section>
